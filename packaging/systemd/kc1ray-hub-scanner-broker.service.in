[Unit]
Description=KC1RAY Hub Scanner local radio control
Requires=asterisk.service
PartOf=asterisk.service
After=asterisk.service

[Service]
Type=exec
User=kc1ray-radio
Group=kc1ray-read
SupplementaryGroups=kc1ray-control @ASTERISK_GROUP@
RuntimeDirectory=kc1ray-hub-scanner
RuntimeDirectoryMode=2750
RuntimeDirectoryPreserve=no
ReadWritePaths=/var/lib/kc1ray-hub-scanner /run/kc1ray-hub-scanner
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/broker.py
ExecStartPost=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/tools/runtime_check.py socket
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0027
Environment=KC1RAY_CONFIG=/etc/kc1ray-hub-scanner/config.toml
WorkingDirectory=/opt/kc1ray-hub-scanner/current
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
