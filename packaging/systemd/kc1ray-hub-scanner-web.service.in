[Unit]
Description=KC1RAY Hub Scanner authenticated web interface
Requires=kc1ray-hub-scanner-broker.service
PartOf=kc1ray-hub-scanner-broker.service
Wants=kc1ray-hub-scanner-monitor.service
After=kc1ray-hub-scanner-broker.service kc1ray-hub-scanner-monitor.service

After=kc1ray-hub-scanner-admin.service

[Service]
Type=exec
User=kc1ray-web
Group=kc1ray-web
SupplementaryGroups=kc1ray-read kc1ray-control
ReadOnlyPaths=/var/lib/kc1ray-hub-scanner /var/cache/kc1ray-hub-scanner /run/kc1ray-hub-scanner
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ExecStart=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/dashboard.py
ExecStartPost=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/tools/runtime_check.py web
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0027
Environment=KC1RAY_CONFIG=/etc/kc1ray-hub-scanner/config.toml
WorkingDirectory=/opt/kc1ray-hub-scanner/current
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
