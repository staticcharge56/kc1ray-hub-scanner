[Unit]
Description=KC1RAY Hub Scanner restricted administration helper
After=local-fs.target

[Service]
Type=exec
User=root
Group=kc1ray-control
SupplementaryGroups=kc1ray-read kc1ray-web
RuntimeDirectory=kc1ray-hub-scanner-admin
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=kc1ray-hub-scanner-admin
StateDirectoryMode=0700
ReadWritePaths=/etc/kc1ray-hub-scanner /run/kc1ray-hub-scanner-admin /var/lib/kc1ray-hub-scanner-admin
ReadWritePaths=/var/lib/kc1ray-hub-scanner-package/operation.lock
ReadOnlyPaths=-/etc/asterisk
InaccessiblePaths=-/run/asterisk
ReadWritePaths=/etc/systemd/system/kc1ray-hub-scanner-netwatch.timer.d /etc/systemd/system/kc1ray-hub-scanner-allstarnets.timer.d
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/admin_service.py
ExecStartPost=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/tools/runtime_check.py admin
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0027
Environment=KC1RAY_CONFIG=/etc/kc1ray-hub-scanner/config.toml
WorkingDirectory=/opt/kc1ray-hub-scanner/current
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
