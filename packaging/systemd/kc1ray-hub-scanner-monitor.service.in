[Unit]
Description=KC1RAY Hub Scanner activity monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=kc1ray-monitor
Group=kc1ray-read
ReadWritePaths=/var/lib/kc1ray-hub-scanner-monitor /var/cache/kc1ray-hub-scanner
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ExecStart=/usr/bin/python3 -B -E -s /opt/kc1ray-hub-scanner/current/monitor.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
UMask=0027
Environment=KC1RAY_CONFIG=/etc/kc1ray-hub-scanner/config.toml
WorkingDirectory=/opt/kc1ray-hub-scanner/current
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
